cabal-version:      3.4
name:               pkg-a
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  A.Core
    build-depends:    base
    default-language: GHC2024

test-suite pkg-a-test
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ASpec.hs
    build-depends:    base
    default-language: GHC2024
