cabal-version:      3.4
name:               buildable
version:            0.1.0.0
build-type:         Simple

-- F005 T5 fixture:一個 library + 一個 executable,只依賴 base,保證建得起來。
-- cabal.project 讓 cabal 停在這裡,不會往上找到 knot-hs 自己的專案。

library
    hs-source-dirs:   src
    exposed-modules:  Demo.Core
    build-depends:    base
    default-language: GHC2024

executable demo-exe
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base, buildable
    default-language: GHC2024
