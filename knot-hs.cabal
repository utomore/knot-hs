cabal-version:      3.4
name:               knot-hs
version:            0.0.1.0
synopsis:           Haskell code knowledge graph generator for dev-flow
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  Knot.Meta
                      Knot.Meta.Types
                      Knot.Meta.Discovery
                      Knot.Meta.CabalModel
                      Knot.Meta.SourceIndex
                      Knot.Meta.HieLocate
                      Knot.Extract
                      Knot.Extract.Types
                      Knot.Extract.Backend
                      Knot.Extract.ImportScan
                      Knot.Graph
                      Knot.Graph.Types
                      Knot.Graph.FactGate
                      Knot.Graph.NodeMint
                      Knot.Graph.EdgeDerive
                      Knot.Export
                      Knot.Export.Types
                      Knot.Export.Encode
                      Knot.Export.Commit
                      Knot.Query
                      Knot.Query.Types
                      Knot.Query.Load
                      Knot.Query.Engine
                      Knot.Query.Render
    build-depends:    base ^>=4.22
                    , Cabal ^>=3.16
                    , Cabal-syntax ^>=3.16
                    , aeson ^>=2.3
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
    ghc-options:      -Wall
    default-language: GHC2024

executable knot
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Knot.App.Cli
                      Knot.App.Report
                      Knot.App.Run
                      Knot.App.Summary
    build-depends:    base ^>=4.22
                    , knot-hs
                    , optparse-applicative ^>=0.19
                    , text
    ghc-options:      -Wall
    default-language: GHC2024

test-suite knot-test
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test, app
    main-is:          Main.hs
    other-modules:    Knot.App.Cli
                      Knot.App.Report
                      Knot.App.Run
                      Knot.App.Summary
    build-depends:    base ^>=4.22
                    , aeson ^>=2.3
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , hedgehog
                    , knot-hs
                    , optparse-applicative ^>=0.19
                    , process
                    , tasty
                    , tasty-hedgehog
                    , tasty-hunit
                    , text
    ghc-options:      -Wall
    default-language: GHC2024
